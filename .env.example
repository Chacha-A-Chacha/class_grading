# Local PostgreSQL example only. Use an encoded, unique password in your .env.
DATABASE_URL="postgresql://postgres:replace-me@127.0.0.1:5433/class_grading?schema=public"
# Per application/worker process; size the total across all processes
# (docs/performance.md suggests 10 for web and 3 for the worker).
DATABASE_POOL_SIZE=5
# Connections for the expiry worker process (npm run worker).
WORKER_POOL_SIZE=3
# Shown in pg_stat_activity and logs: web, worker or cleanup.
DB_APP_NAME=web
# Required only by npm run db:seed. No admin is created during install/build.
ADMIN_EMAIL=""
ADMIN_NAME=""
# Integration tests create/drop only a uniquely named schema in this database.
TEST_DATABASE_URL=""
# Canonical browser origin. Production requires HTTPS; local development uses HTTP.
APP_URL="http://127.0.0.1:3000"
# Three independent random secrets, each at least 32 characters. Never reuse them.
AUTH_COOKIE_SECRET=""
AUTH_CODE_SECRET=""
AUTH_MFA_SECRET=""
# Owner authenticator (TOTP) step. Off for now; set to "required" after running
# npm run admin:setup-mfa. AUTH_MFA_SECRET is only used when this is enabled.
ADMIN_MFA=off
# SMTP on TLS port 465 or STARTTLS port 587. No plaintext/logging delivery fallback.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
# Enable only behind a proxy that overwrites X-Real-IP on every request
# (Caddy: header_up X-Real-IP {remote_host}). Required in production: without it,
# per-IP sign-in limits are skipped in development and sign-in refuses to run.
TRUST_PROXY_IP=false
