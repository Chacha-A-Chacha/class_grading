{
  "name": "class-grading",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:setup-mfa": "tsx scripts/setup-admin-mfa.ts",
    "db:cleanup-auth": "tsx scripts/cleanup-auth.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "db:studio": "prisma studio",
    "test:db": "tsx --test tests/db/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.7",
    "fflate": "0.8.3",
    "input-otp": "1.5.0",
    "iron-session": "9.0.1",
    "lucide-react": "1.56.0",
    "next": "16.4.2",
    "nodemailer": "10.1.0",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.12",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.30",
    "prisma": "7.10.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
